{
  "name": "revue-md",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start": "expo start",
    "build:preview:apk:arm64": "bunx eas-cli build --platform android --profile preview",
    "prebuild": "expo prebuild",
    "postinstall": "lefthook install",
    "lint": "oxlint . -c ./node_modules/ironoxlint/oxlint/strict-react.json --ignore-path .gitignore && oxfmt . -c ./oxfmt.json --check --ignore-path .gitignore && eslint .",
    "format": "oxlint . -c ./node_modules/ironoxlint/oxlint/strict-react.json --fix --ignore-path .gitignore && oxfmt . -c ./oxfmt.json --ignore-path .gitignore && eslint . --fix",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.10",
    "@gorhom/bottom-sheet": "^5.2.10",
    "expo": "^55.0.0",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.15",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.17",
    "expo-haptics": "~55.0.14",
    "expo-linking": "~55.0.14",
    "expo-router": "~55.0.13",
    "expo-status-bar": "~55.0.5",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.2",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@typescript-eslint/parser": "^8.59.0",
    "ironoxlint": "^0.9.8",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.16",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "react-test-renderer": "19.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3"
  },
  "knip": {
    "ignore": [
      "metro.config.js"
    ]
  }
}
